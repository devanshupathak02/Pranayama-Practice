# Upstash Redis (Single vendor storage for push subscriptions & session tokens)
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# Upstash QStash (Single vendor scheduler for delayed phase change webhooks)
QSTASH_TOKEN="..."
QSTASH_CURRENT_SIGNING_KEY="..."
QSTASH_NEXT_SIGNING_KEY="..."

# Web Push VAPID Credentials (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY="<YOUR_VAPID_PUBLIC_KEY>"
VAPID_PRIVATE_KEY="<YOUR_VAPID_PRIVATE_KEY>"
VAPID_SUBJECT="mailto:admin@smwr.org"
