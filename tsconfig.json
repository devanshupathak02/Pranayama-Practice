{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "./website",
    "typeRoots": [
      "./website/node_modules/@types"
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "scripts/**/*",
    "website/next-env.d.ts",
    "website/**/*.ts",
    "website/**/*.tsx",
    "website/.next/types/**/*.ts",
    "website/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "website/node_modules",
    "public",
    "website/public",
    "website/.next"
  ]
}
